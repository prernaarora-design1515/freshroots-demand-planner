# Local: embedded Postgres, no Neon needed
DATABASE_URL=pglite:./.pglite
# Production: Neon connection string
# DATABASE_URL=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Optional locally; without it the app shows rule summaries instead of AI explanations
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# First-admin setup: any secret phrase (8+ characters). Open /setup and enter it once.
SETUP_CODE=
# Set to true to hide the dashboard from signed-out visitors (default: read-only view for everyone)
REQUIRE_LOGIN_TO_VIEW=false
